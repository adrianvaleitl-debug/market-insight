{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Market Insight",
  "version": "2.8.0",
  "identifier": "com.adrianvale.marketinsight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Market Insight",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 700,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}